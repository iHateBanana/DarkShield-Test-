{
  "manifest_version": 3,
  "name": "DarkShield",
  "version": "1.0.0",
  "description": "Detects confirmshaming and false urgency dark patterns on e-commerce pages.",

  "permissions": [
    "storage"
  ],

  "background": {
    "service_worker": "src/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.booking.com/*",
        "https://www.ryanair.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "DarkShield"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
