{
  "manifest_version": 3,
  "name": "DarkShield",
  "version": "2.0",
  "description": "Detects dark UX patterns on web pages",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://openrouter.ai/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["regex-detector.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["regex-detector.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
